# Copy to .env and chmod 600 .env. These are placeholders, not working credentials.
COMPOSE_PROJECT_NAME=pi-downloader
TG_API_ID=replace_me
TG_API_HASH=replace_me
TG_BOT_TOKEN=replace_me
ALLOWED_USER_IDS=123456789
ALLOWED_CHAT_IDS=123456789
QBIT_USERNAME=admin
QBIT_PASSWORD=replace_me
QBIT_BIND_IP=127.0.0.1
MEDIA_DIR=./data/media
TORRENTS_DIR=./data/torrents
WORKSPACE_DIR_HOST=./data/workspace
APPDATA_DIR=./data/app-data
PUID=1000
PGID=1000
MAX_CONCURRENT_TASKS=2
MAX_QUEUE_SIZE=50
MAX_MEDIA_FILES=10
MAX_DOWNLOAD_BYTES=8000000000
MAX_UPLOAD_BYTES=2000000000
MAX_EXTRACT_BYTES=10000000000
MAX_EXTRACT_FILES=10000
TASK_TIMEOUT=900
VIDEO_TIMEOUT=3600
ORCHESTRATOR_MEMORY_LIMIT=2g
